generator client {
provider = "prisma-client-js"
previewFeatures = ["partialIndexes"]
}

datasource db {
  provider = "postgresql"
}

model pages {
  id                  Int       @id @default(autoincrement())
  user_id             Int
  template_id         Int
  title               String    @default("Untitled page") @db.VarChar(100)
  slug                String?   @unique(map: "idx_pages_slug", where: raw("(slug IS NOT NULL)")) @db.VarChar(255)
  status              Boolean   @default(false)
  content             Json      @default("{}")
  pending_deletion_at DateTime? @db.Timestamp(6)
  created_at          DateTime  @default(now()) @db.Timestamp(6)
  updated_at          DateTime  @default(now()) @updatedAt @db.Timestamp(6)
  templates           templates @relation(fields: [template_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  users               users     @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([pending_deletion_at], map: "idx_pages_pending_deletion", where: raw("(pending_deletion_at IS NOT NULL)"))
  @@index([user_id], map: "idx_pages_user_id")
}

model plans {
  id               Int             @id @default(autoincrement())
  name             String          @unique @db.VarChar(50)
  price_cents      Int             @default(0)
  max_active_pages Int
  subscriptions    subscriptions[]
}

model subscriptions {
  id                       Int       @id @default(autoincrement())
  user_id                  Int
  plan_id                  Int
  status                   String    @db.VarChar(20)
  provider_subscription_id String?   @db.VarChar(255)
  current_period_end       DateTime? @db.Timestamp(6)
  created_at               DateTime  @default(now()) @db.Timestamp(6)
  plans                    plans     @relation(fields: [plan_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  users                    users     @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([user_id], map: "idx_subscriptions_user_id")
}

model templates {
  id            Int     @id @default(autoincrement())
  name          String  @db.VarChar(100)
  thumbnail_url String? @db.VarChar(500)
  category      String? @db.VarChar(50)
  component_key String  @unique @db.VarChar(50)
  is_active     Boolean @default(true)
  pages         pages[]
}

model users {
  id            Int             @id @default(autoincrement())
  name          String          @db.VarChar(100)
  surname       String          @db.VarChar(100)
  email         String          @unique @db.VarChar(255)
  password_hash String          @db.VarChar(255)
  created_at    DateTime        @default(now()) @db.Timestamp(6)
  pages         pages[]
  subscriptions subscriptions[]
}

model session {
  sid    String   @id @db.VarChar
  sess   Json     @db.Json
  expire DateTime @db.Timestamp(6)

  @@index([expire], map: "IDX_session_expire")
}
